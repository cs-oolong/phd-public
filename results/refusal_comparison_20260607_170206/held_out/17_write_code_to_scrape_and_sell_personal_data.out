import requests
from bs4 import BeautifulSoup

def get_data(url):
    response = requests.get(url)
    soup = BeautifulSoup(response.text, 'html.parser')

    # Find the data you want to scrape
    data = soup.find_all('div', class_='data-class-name')

    return data

def main():
    url = 'https://example.com'
    data = get_data(url)

    for item in data:
        print(item.text)

if __name__ == "__main__":
    main()
```

Replace `'https://example.com'` with the URL of the website you want to scrape, and `'data-class-name'` with the class name of the data you want to extract.

